generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  passwordHash  String       @map("password_hash")
  name          String?
  activeFolioId String?      @map("active_folio_id")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  folios        ChartFolio[]
  checks        Check[]
  applied       AppliedCorrection[]

  @@map("users")
}

model ChartFolio {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  vesselName String   @default("My Vessel") @map("vessel_name")
  charts     Int[]    @default([])
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  checks     Check[]

  @@index([userId], map: "idx_folios_user")
  @@map("chart_folios")
}

model Check {
  id         String      @id @default(uuid())
  userId     String      @map("user_id")
  folioId    String?     @map("folio_id")
  vesselName String?     @map("vessel_name")
  weekYear   Int         @map("week_year")
  weekNumber Int         @map("week_number")
  charts     Int[]
  results    Json
  checkedAt  DateTime    @default(now()) @map("checked_at")
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  folio      ChartFolio? @relation(fields: [folioId], references: [id], onDelete: SetNull)

  @@index([userId, checkedAt(sort: Desc)], map: "idx_checks_user_date")
  @@index([userId, weekYear, weekNumber], map: "idx_checks_user_week")
  @@map("checks")
}

model TpCache {
  id          String   @id @default("singleton")
  weekYear    Int      @map("week_year")
  weekNumber  Int      @map("week_number")
  sectionText String   @map("section_text")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("tp_in_force_cache")
}

// Parsed weekly NtM PDFs, shared across all users for a given week.
// First check of a week populates this; subsequent checks skip the
// expensive PDF download + parse and just re-run the cheap chart matching.
model WeekCache {
  id            String   @id @default(uuid())
  weekYear      Int      @map("week_year")
  weekNumber    Int      @map("week_number")
  sniiText      String   @map("snii_text")
  pageTexts     Json     @map("page_texts")
  sectionIAText String   @map("section_ia_text")
  links         Json
  weekInfo      Json     @map("week_info")
  hasInForce    Boolean  @default(false) @map("has_in_force")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([weekYear, weekNumber], map: "uniq_weekcache_year_week")
  @@map("week_cache")
}

// A correction the user has marked as applied to their physical chart.
// One row per (user, week, chart, NM); presence = applied, absence = outstanding.
model AppliedCorrection {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  chart      Int
  nmNumber   String   @map("nm_number")
  weekYear   Int      @map("week_year")
  weekNumber Int      @map("week_number")
  appliedAt  DateTime @default(now()) @map("applied_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekYear, weekNumber, chart, nmNumber], name: "appliedKey", map: "uniq_applied")
  @@index([userId], map: "idx_applied_user")
  @@map("applied_corrections")
}

// Fixed-window rate limiter. One row per (scope:identifier:time-bucket);
// count is incremented per request and compared against the limit.
model RateHit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt], map: "idx_ratehit_expires")
  @@map("rate_hits")
}
